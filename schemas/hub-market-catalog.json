{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/opendevtools-org/hub-community-plugins/main/schemas/hub-market-catalog.json",
  "title": "Hub Market Catalog",
  "type": "object",
  "required": ["plugins"],
  "additionalProperties": true,
  "properties": {
    "updatedAt": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "homepage": { "type": "string", "format": "uri" },
          "repo": { "type": "string", "description": "owner/name" },
          "ref": { "type": "string" },
          "visibility": { "type": "string", "enum": ["community", "private"] },
          "install": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "default": "compose" },
              "cloneUrl": { "type": "string" },
              "composeFile": {
                "type": "string",
                "description": "Path in this repo, typically plugins/<id>/docker-compose.backend.yml"
              },
              "role": { "type": "string", "default": "backend" },
              "command": {
                "type": "string",
                "description": "Copied by Hub Market: download backend compose into plugins/<id>/ and include it from docker-compose.apps.yml. If omitted, Hub derives it from composeFile."
              }
            }
          },
          "clients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string" },
                "launchPath": { "type": "string" },
                "composeFile": {
                  "type": "string",
                  "description": "plugins/<id>/docker-compose.frontend.yml"
                },
                "command": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
