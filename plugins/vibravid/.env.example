# Merge into the homelab-deploy `.env` (do not commit secrets).

VIBRAVID_TAG=latest
VIBRAVID_PORT=3100
VIBRAVID_SECRET_KEY=replace-with-a-long-random-string

# Bind mounts (defaults are under ./data/vibravid/ on the site folder).
# VIBRAVID_DB_DIR=./data/vibravid/db
# VIBRAVID_VIDEO_DIR=./data/vibravid/video
# VIBRAVID_LOGS_DIR=./data/vibravid/logs
# VIBRAVID_CONFIG_DIR=./data/vibravid/config
# VIBRAVID_BINARY_DIR=./data/vibravid/binary

# Django hosts. Add your LAN IP or hostname, and matching CSRF origins.
# VIBRAVID_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
# VIBRAVID_CSRF_TRUSTED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://192.168.1.10:3100

# Optional TMDB key (posters / ARR matching). Upstream reads this at start.
# TMDB_API_KEY=
