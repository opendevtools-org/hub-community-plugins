# Merge into the site `.env` (do not commit secrets).

GUACAMOLE_TAG=latest
# Host port when running this compose without Hub port override.
# GUACAMOLE_PORT=8080

# Bind mount for PostgreSQL + Guacamole config (default ./data/guacamole on the site folder).
# GUACAMOLE_DATA_DIR=./data/guacamole

# Optional timezone inside the container.
# TZ=UTC

# Optional Guacamole extensions (comma-separated, no spaces), e.g. auth-totp
# EXTENSIONS=
